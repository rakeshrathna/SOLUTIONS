# ============================================================================
# RAILWAY POSTGRESQL CONFIGURATION (EDUiDEAL ACADEMY BACKEND)
# ============================================================================
# Full connection string provided by Railway
DATABASE_URL=postgresql://postgres:your_password@postgres.railway.internal:5432/railway
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.railway.internal:5432/railway

# Railway / Postgres Standard Variables
PGHOST=postgres.railway.internal
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=railway

# Spring Boot Data Source Variables
DB_HOST=postgres.railway.internal
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=railway

# Server & Auth Configuration
PORT=8080
SERVER_PORT=8080
JWT_SECRET=your_long_random_jwt_secret_key_here

# ============================================================================
# SUPABASE CONFIGURATION (EDUiDEAL ACADEMY FRONTEND)
# Available in: Supabase Dashboard -> Project Settings -> API
# ============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
